{
  "name": "rune",
  "version": "0.1.1",
  "description": "Encrypted, offline, zero-knowledge desktop notepad.",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/glowxx/Rune.git"
  },
  "homepage": "https://github.com/glowxx/Rune#readme",
  "bugs": {
    "url": "https://github.com/glowxx/Rune/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.whiteboard.config.js && node scripts/verify-whiteboard-build.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "audit:rust": "cargo audit --file src-tauri/Cargo.lock",
    "verify": "npm run check && npm run test:frontend && npm run test:rust && npm run format:rust && npm run lint:rust && npm run audit:dependencies && npm run audit:rust && npm run build",
    "tauri": "tauri",
    "build:installer": "npm run tauri build -- --bundles msi",
    "build:all": "npm run tauri build"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2",
    "d3": "^7.9.0",
    "dompurify": "^3.4.12",
    "excalidraw-local": "npm:@excalidraw/excalidraw@0.18.1",
    "marked": "^18.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "jsdom": "^26.1.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
